#!/usr/bin/env bash
# Atomically replace the daemon binary on the device, with rollback safety.
#
# Stops bridgething.service and bridgething-weston.service first (the latter
# cascades chromium-kiosk shutdown via PartOf), uploads via scp to a temp
# file, rotates the existing .current to .previous (so a bad push has
# something to roll back to), atomically renames the new binary into
# .current, then restarts both. Stopping the consumers up front is what
# keeps a 17 MB release transfer over USB-CDC from contending with chromium's
# resident set and triggering an OOM cascade or USB watchdog reset (which an
# earlier rsync flow without this stop produced reliably on 1 GB Car Thing
# hardware).
#
# /opt/bridgething is a bind-mount from the settings partition on both prod
# and dev images via bridgething-opt-overlay, so the dropped binary survives
# bootslot swaps and OTA upgrades. The /usr/bin/bridgething launcher prefers
# .current over the in-rootfs squashfs fallback. If the new daemon fails to
# start 3 times in 60 seconds, bridgething-rollback.service promotes
# .previous back to .current and the device keeps running on the prior
# binary; .broken backups land alongside for diagnosis.
#
# Usage:
#   bridgething-push-daemon <local-path>
set -euo pipefail

if [ $# -ne 1 ]; then
    cat <<EOF >&2
usage: bridgething-push-daemon <local-path>

Pushes <local-path> to /opt/bridgething/daemon/bridgething.current on the
device. Rotates the existing .current to .previous for rollback safety,
stops bridgething + weston (and chromium-kiosk via cascade), atomically
swaps the binary, then restarts both.
EOF
    exit 2
fi

LOCAL="$1"

if [ ! -x "$LOCAL" ]; then
    echo "bridgething-push-daemon: not an executable file: $LOCAL" >&2
    exit 1
fi

HOST="${SUPERBIRD_HOST:-10.42.1.2}"
DEST_DIR="/opt/bridgething/daemon"
CURRENT="${DEST_DIR}/bridgething.current"
PREVIOUS="${DEST_DIR}/bridgething.previous"
TMP="${DEST_DIR}/bridgething.incoming.$$"

SSH_OPTS=(-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o LogLevel=ERROR)

ssh_dev() { ssh "${SSH_OPTS[@]}" "root@${HOST}" "$@"; }

echo "[push-daemon] stopping bridgething + bridgething-weston"
ssh_dev "systemctl stop bridgething-weston.service bridgething.service"

echo "[push-daemon] uploading $(basename "$LOCAL") ($(du -h "$LOCAL" | cut -f1)) to ${HOST}:${TMP}"
scp -C "${SSH_OPTS[@]}" -q "$LOCAL" "root@${HOST}:${TMP}"

echo "[push-daemon] rotating current -> previous, swapping new -> current"
ssh_dev "
    set -eu
    chmod 0755 ${TMP}
    if [ -e ${CURRENT} ]; then
        mv -f ${CURRENT} ${PREVIOUS}
    fi
    mv -f ${TMP} ${CURRENT}
    systemctl reset-failed bridgething.service 2>/dev/null || true
"

echo "[push-daemon] restarting bridgething + bridgething-weston"
ssh_dev "systemctl start bridgething.service bridgething-weston.service"

echo "[push-daemon] done."
