#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ]; then
    cat <<EOF >&2
usage: bridgething-push-daemon <local-path>

Pushes <local-path> to /opt/bridgething/daemon/bridgething.current on the
device. Rotates the existing .current to .previous for rollback safety,
stops bridgething, atomically swaps the binary, then restarts.
EOF
    exit 2
fi

LOCAL="$1"

if [ ! -x "$LOCAL" ]; then
    echo "bridgething-push-daemon: not an executable file: $LOCAL" >&2
    exit 1
fi

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/device.sh"
DEST_DIR="/opt/bridgething/daemon"
CURRENT="${DEST_DIR}/bridgething.current"
PREVIOUS="${DEST_DIR}/bridgething.previous"
TMP="${DEST_DIR}/bridgething.incoming.$$"

echo "[push-daemon] stopping bridgething"
device_ssh "systemctl stop bridgething.service"

echo "[push-daemon] uploading $(basename "$LOCAL") ($(du -h "$LOCAL" | cut -f1)) to ${DEVICE_HOST}:${TMP}"
device_scp -C -q "$LOCAL" "root@${DEVICE_HOST}:${TMP}"

echo "[push-daemon] rotating current -> previous, swapping new -> current"
device_ssh "
    set -eu
    chmod 0755 ${TMP}
    if [ -e ${CURRENT} ]; then
        mv -f ${CURRENT} ${PREVIOUS}
    fi
    mv -f ${TMP} ${CURRENT}
    systemctl reset-failed bridgething.service 2>/dev/null || true
"

echo "[push-daemon] restarting bridgething"
device_ssh "systemctl restart bridgething.service"

echo "[push-daemon] done."
