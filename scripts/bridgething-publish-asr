#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHANNEL=stable
DRY=0
VERSION=""
MODEL_PATH=""
MODEL_NAME=""

log()  { printf '\033[1;36m[publish-asr]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[publish-asr]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[publish-asr] error:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
usage: bridgething-publish-asr --version <ver> --model <path> --name <whisper-size> [options]

  --version <ver>   asr model version to publish
  --model <path>    the ggml model file
  --name <size>     the whisper model family name (tiny.en, base.en, ...)
  --channel <ch>    default: stable
  --dry-run         digest and print the manifest; upload nothing

Publishing needs an rclone-reachable 'r2' remote plus R2_BUCKET and PUBLIC_BASE.
EOF
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --version) VERSION="${2:?}"; shift 2 ;;
    --model) MODEL_PATH="${2:?}"; shift 2 ;;
    --name) MODEL_NAME="${2:?}"; shift 2 ;;
    --channel) CHANNEL="${2:?}"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -n "$VERSION" ] && [ -n "$MODEL_PATH" ] && [ -n "$MODEL_NAME" ] || usage
[ -f "$MODEL_PATH" ] || die "no model at $MODEL_PATH"

digest() { shasum -a 256 "$1" | awk '{print $1}'; }
bytes()  { wc -c <"$1" | tr -d ' '; }

KEY="asr/${CHANNEL}/model/${VERSION}/ggml-${MODEL_NAME}.bin"
SHA=$(digest "$MODEL_PATH"); SIZE=$(bytes "$MODEL_PATH")
log "asr ${VERSION} (${MODEL_NAME})  ${SIZE} bytes  ${SHA:0:12}"

MANIFEST=$(jq -n \
  --arg version "$VERSION" \
  --arg model "$MODEL_NAME" \
  --arg updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg url "${PUBLIC_BASE:-}/${KEY}" \
  --argjson size "$SIZE" \
  --arg sha256 "$SHA" \
  '{version: $version, model: $model, updated_at: $updated_at,
    android: {url: $url, size: $size, sha256: $sha256}}')

if [ "$DRY" = 0 ]; then
  command -v rclone >/dev/null 2>&1 || die "rclone is not installed"
  : "${R2_BUCKET:?R2_BUCKET is required}"
  : "${PUBLIC_BASE:?PUBLIC_BASE is required}"
  if [ -n "$(rclone lsf "r2:${R2_BUCKET}/${KEY}" 2>/dev/null)" ]; then
    live=$(rclone cat "r2:${R2_BUCKET}/${KEY}" | shasum -a 256 | awk '{print $1}')
    if [ "$live" = "$SHA" ]; then
      log "already published, identical bytes: ${KEY}"
    else
      die "${KEY} already exists serving ${live:0:12}, and this file is ${SHA:0:12}.
     bump the version rather than redefining a published one."
    fi
  else
    "$REPO_ROOT/scripts/r2-put" "$MODEL_PATH" "$KEY" application/octet-stream
  fi
  TMP=$(mktemp); printf '%s\n' "$MANIFEST" > "$TMP"
  "$REPO_ROOT/scripts/r2-put" "$TMP" "asr/${CHANNEL}/manifest.json" \
    application/json "public, max-age=300, must-revalidate"
  rm -f "$TMP"
else
  warn "dry run: nothing uploaded"
fi

printf '%s\n' "$MANIFEST"
