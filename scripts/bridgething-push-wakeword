#!/usr/bin/env bash
set -euo pipefail

[ $# -eq 0 ] || { echo "usage: bridgething-push-wakeword" >&2; exit 2; }

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/scripts/device.sh"
MODELS="$REPO_ROOT/crates/wakeword/models"

"$REPO_ROOT/scripts/bridgething-convert-wakeword" >/dev/null
[ -f "$MODELS/hey_bridgething.btww" ] || { echo "missing model: $MODELS/hey_bridgething.btww" >&2; exit 1; }

echo "pushing hey_bridgething.btww -> ${DEVICE_HOST}"
device_scp -q "$MODELS/hey_bridgething.btww" "root@${DEVICE_HOST}:/tmp/hey_bridgething.btww"
device_scp -q "$MODELS/NOTICE.md" "root@${DEVICE_HOST}:/tmp/wakeword-NOTICE.md"

device_ssh 'set -e
    mkdir -p /var/bridgething/wakeword
    install -m 0644 /tmp/hey_bridgething.btww /var/bridgething/wakeword/hey_bridgething.btww
    install -m 0644 /tmp/wakeword-NOTICE.md /var/bridgething/wakeword/NOTICE.md
    rm -f /tmp/hey_bridgething.btww /tmp/wakeword-NOTICE.md
    systemctl restart bridgething.service'

echo "restarted. confirm it loaded with:"
echo "  scripts/superbird-ssh 'journalctl -u bridgething -b | grep \"wake word loaded\"'"
