{
  "name": "@bridgething/adapter",
  "version": "0.0.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "bridgething-adapter",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "npmClient": "bun"
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0-alpha.65"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --js binding.cjs --features napi && bun run make-module",
    "build:debug": "napi build --platform --js binding.cjs --features napi && bun run make-module",
    "make-module": "echo \"export * from './binding.cjs';\" > index.js && ./export.sh",
    "version": "napi version"
  }
}
