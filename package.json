{
  "name": "turbo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "example:node-dev": "cd packages/examples/node-dev && bun run dev",
    "mobile": "cd mobile && bun run"
  },
  "devDependencies": {
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.3.13",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "crates/lib",
    "packages/*",
    "packages/gateway/*",
    "packages/examples/*",
    "mobile"
  ]
}