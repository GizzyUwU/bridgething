{
  "name": "turbo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:gateway": "cd dev/gateway && bun run dev:gateway"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "5.7.3",
    "@eslint/js": "^9.18.0",
    "@types/bun": "latest",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript-eslint": "^8.19.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.1.43",
  "workspaces": [
    "lib",
    "gateway",
    "adapter",
    "dev-gateway",
    "client/typescript"
  ]
}
