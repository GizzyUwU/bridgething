{
  "name": "turbo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "example:node-dev": "cd examples/node-dev && bun run dev"
  },
  "devDependencies": {
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.3.13",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "lib",
    "gateway/typescript",
    "adapters/*",
    "client/typescript",
    "mobile",
    "examples/*"
  ]
}
