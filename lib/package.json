{
  "name": "@bridgething/lib",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup ./ts --watch",
    "prebuild": "bun run version",
    "build": "tsup ./ts",
    "version": "bun run gv && bun run ./scripts/set-version.ts",
    "gv": "genversion --esm --semi ts/version.ts"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "genversion": "3.2.0"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  }
}
