{
  "name": "@bridgething/lib",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "prebuild": "bun run version",
    "build": "tsdown",
    "version": "bun run gv && bun run ./scripts/set-version.ts",
    "gv": "genversion --esm --semi ts/version.ts"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "genversion": "3.2.0",
    "tsdown": "^0.21.10"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "pako": "^2.1.0"
  }
}
