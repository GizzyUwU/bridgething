{
  "name": "@bridgething/adapter-react-native",
  "version": "0.1.0",
  "description": "bridgething bluetooth adapter for react native",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "#yarn workspace @bridgething/adapter-react-native-example",
    "typecheck": "#tsc",
    "lint": "#eslint \"**/*.{js,ts,tsx}\"",
    "clean": "#rm -rf android/build example/android/build example/android/app/build example/ios/build lib",
    "build": "#bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyEamigh/bridgething.git"
  },
  "author": "Joey Eamigh <55670930+JoeyEamigh@users.noreply.github.com> (https://github.com/JoeyEamigh)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JoeyEamigh/bridgething/issues"
  },
  "homepage": "https://github.com/JoeyEamigh/bridgething#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@bridgething/lib": "workspace:*",
    "pako": "^2.1.0",
    "react-native-ble-plx": "^3.4.0"
  },
  "devDependencies": {
    "@bridgething/gateway": "workspace:*",
    "@eslint/js": "*",
    "@react-native-community/cli": "15.1.3",
    "@react-native/eslint-config": "^0.77.0",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.0.8",
    "eslint": "*",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "prettier": "*",
    "react": "19.0.0",
    "react-native": "0.77.0",
    "react-native-builder-bob": "^0.36.0",
    "typescript": "*"
  },
  "resolutions": {
    "@types/react": "^19.0.8"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "bun@1.2.1",
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  }
}
