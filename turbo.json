{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["RUSTUP_HOME", "RUSTUP_TOOLCHAIN", "CARGO_HOME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "native/**", "lib/**"]
    },
    "nitro:codegen": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "nitro.json", "package.json"],
      "outputs": ["nitrogen/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "ts/**", "scripts/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "ts/**", "scripts/**", "eslint.config.*", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
