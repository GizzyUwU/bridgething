+
+// makeException/getExceptionMessage (declared in ios/utils/RuntimeError.hpp) live out-of-line in
+// this TU (instead of a new file, which `bun patch` cannot apply) so they are always compiled by
+// clang with C++ exceptions enabled. They are called from Swift; swiftc compiles inline C++ under
+// -fignore-exceptions, which discards catch handlers and turns the internal throw/rethrow into
+// std::terminate() (SIGABRT).
+
+#include "NitroTypeInfo.hpp"
+#include "RuntimeError.hpp"
+#include <stdexcept>
+
+namespace margelo::nitro {
+
+std::exception_ptr makeException(const std::string& message) {
+  return std::make_exception_ptr(std::runtime_error(message));
+}
+
+std::string getExceptionMessage(const std::exception_ptr& exception) {
+  if (exception == nullptr) [[unlikely]] {
+    throw std::runtime_error("Cannot get error message of a nullptr exception_ptr!");
+  }
+
+  try {
+    std::rethrow_exception(exception);
+  } catch (const std::exception& error) {
+    return error.what();
+  } catch (...) {
+    std::string errorName = TypeInfo::getCurrentExceptionName();
+    return "Unknown " + errorName + " exception";
+  }
+}
+
+} // namespace margelo::nitro
