diff --git a/cpp/utils/CommonGlobals.cpp b/cpp/utils/CommonGlobals.cpp
index 126fe49becd059e4e3986ffbbed01c00dd8c40a0..a009181f27d5642f7d614f50f1c54b9fa203d9d0 100644
--- a/cpp/utils/CommonGlobals.cpp
