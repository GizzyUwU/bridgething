---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { AdminSources } from '../../components/store/AdminSources';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="source moderation" description="Moderate submitted catalog sources." noindex>
  <Header />
  <main class="container-site w-full flex-1 py-12 md:py-16">
    <header class="mb-10 max-w-2xl">
      <h1 class="mb-1">source moderation</h1>
      <p class="text-white/60">
        promote a submitted catalog source out of quarantine, vouch for it, or drop it. quarantined sources are visible
        on the store page but never reach the published directory or the phone app.
      </p>
    </header>

    <AdminSources client:load />
  </main>
  <Footer />
</Layout>
