---
import Snippet from '../../components/docs/Snippet.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { methodCount, surfaceHasMethods } from '../../lib/docs.ts';
import { renderMdInline } from '../../lib/md.ts';
import { loadSurfaceDocs } from '../../lib/sdk.ts';
import { SITE } from '../../lib/site.ts';

const docs = await loadSurfaceDocs();
const surfaces = docs.surfaces.filter(surfaceHasMethods).sort((a, b) => a.title.localeCompare(b.title));

function blurb(description?: string): string {
  if (!description) return '';
  const flat = description.replace(/\s+/g, ' ').trim();
  const end = flat.search(/\.\s/);
  return end === -1 ? flat : flat.slice(0, end + 1);
}

const refdes = 'text-accent m-0 mb-4 font-mono text-sm font-normal tracking-normal';

const connectSnippet = `import { BridgethingClient } from '@bridgething/client';

const client = new BridgethingClient(); // auto-connects, auto-reconnects`;

const resultShape = `type TypedRequestResult<Response, Error> =
  | { ok: true; response: Response }
  | { ok: false; kind: 'domain'; error: Error }
  | { ok: false; kind: 'protocol'; error: WireError };`;

const wireErrorShape = `type WireError =
  | { type: 'unsupported' }
  | { type: 'unimplemented' }
  | { type: 'malformed'; data: { reason: string } }
  | { type: 'handlerFailed'; data: { reason: string } };`;

const shapes = [
  {
    label: 'events',
    body: 'the daemon pushes, you subscribe. onXxx returns an unsubscribe function.',
    code: `const off = client.player.onSnapshot(r => render(r.state));
off(); // stop listening`,
  },
  {
    label: 'requests',
    body: 'you ask, the daemon answers. returns a tagged result.',
    code: `const res = await client.player.stateGet();
if (res.ok) render(res.response.state);`,
  },
  {
    label: 'commands',
    body: 'fire-and-forget. resolves once the daemon has taken the message.',
    code: `await client.player.skipNext();`,
  },
];
---

<DocsLayout
  title="webapp sdk"
  current="sdk"
  description="reference for @bridgething/client, the sdk a car thing webapp uses to talk to the on-device daemon.">
  <header class="mb-12">
    <h1>webapp sdk</h1>
    <p class="text-white/60">
      a bridgething webapp is a single-page ui. it runs full-screen in the car thing's chromium kiosk. it reaches the
      on-device daemon through one typed client,
      <a href="https://www.npmjs.com/package/@bridgething/client">@bridgething/client</a>. this reference is generated
      from the daemon's wire types.
    </p>
  </header>

  <section class="mb-14">
    <h2 class={refdes}>d1 - start a project</h2>
    <p class="text-white/60">scaffold a webapp. react, vite, tailwind, and this client come preinstalled.</p>
    <Snippet code="bun create bridgething my-app" lang="bash" />
    <p class="mt-3 text-sm text-white/45">
      source and issues on <a href={`${SITE.github}/bridgething`}>github</a>.
    </p>
  </section>

  <section class="mb-14">
    <h2 class={refdes}>d2 - settings pages</h2>
    <p class="text-white/60">
      apps can ship a companion-side settings ui. it is one self-contained html page rendered in the phone app, with its
      own tiny bridge sdk for config and shared state. see <a href="/docs/settings-pages">settings pages</a>, including
      the <a href="/docs/settings-pages#network">network caveat</a>.
    </p>
  </section>

  <section class="mb-14">
    <h2 class={refdes}>d3 - connect</h2>
    <p class="text-white/60">
      construct the client once and reuse it. the daemon is the sole peer. you never open sockets or address anything
      (unless you are using the web proxy feature).
    </p>
    <Snippet code={connectSnippet} />
  </section>

  <section class="mb-16">
    <h2 class={refdes}>d4 - the three call shapes</h2>
    <p class="mb-6 text-white/60">
      every surface method is one of three shapes. learn these and the whole sdk reads the same way.
    </p>
    {
      shapes.map(s => (
        <div class="mb-6">
          <h3 class="font-display m-0 text-base font-medium">{s.label}</h3>
          <p class="mt-1 mb-2 text-sm text-white/60">{s.body}</p>
          <Snippet code={s.code} />
        </div>
      ))
    }
  </section>

  <section class="mb-16 scroll-mt-24" id="request-results">
    <h2 class={refdes}>d5 - request results</h2>
    <p class="text-white/60">
      a request never returns its payload directly and never throws. it resolves to a tagged result. narrow it on
      <code>ok</code>. this is the <code>TypedRequestResult&lt;Response, Error&gt;</code> in every request's signature:
    </p>
    <Snippet code={resultShape} />
    <ul role="list" class="mt-4 space-y-1.5 text-sm text-white/60">
      <li>
        <code class="text-white/80">ok</code>: the discriminant. <code>true</code> means success; <code>response</code> holds
        the reply.
      </li>
      <li>
        <code class="text-white/80">response</code>: the typed reply payload (the <code>Response</code> in the method's signature).
        only present when <code>ok</code>.
      </li>
      <li>
        <code class="text-white/80">kind</code>: on failure, <code>'domain'</code> (an expected, operation-specific failure,
        e.g. an asset that isn't found) or <code>'protocol'</code> (the request could not be reached or dispatched).
      </li>
      <li>
        <code class="text-white/80">error</code>: the failure detail. your operation's error type when <code>kind</code> is
        <code>'domain'</code>, a <code>WireError</code> when <code>'protocol'</code>.
      </li>
    </ul>
    <p class="mt-4 text-sm text-white/60">
      every request also accepts an optional second argument <code>{'{ timeoutMs }'}</code>.
    </p>
    <p class="mt-6 mb-2 text-sm text-white/60">
      the <code>'protocol'</code> failure carries a <code>WireError</code>: the request was malformed, unsupported, or
      the handler threw.
    </p>
    <Snippet code={wireErrorShape} />
  </section>

  <section>
    <div class="mb-1 border-b border-white/20 pb-2">
      <h2 class={refdes.replace('mb-4', 'mb-1')}>d6 - surfaces</h2>
      <p class="m-0 font-mono text-sm text-white/45">{surfaces.length} surfaces on <code>client.&lt;name&gt;</code></p>
    </div>
    {
      surfaces.map(s => (
        <a href={`/docs/${s.name}`} class="group block border-t border-white/10 py-4 first:border-t-0 hover:border-b-0">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-display group-hover:text-accent text-lg font-medium transition-colors">
              {s.title.toLowerCase()}
            </span>
            <span class="font-mono text-xs text-white/40">{methodCount(s)} methods</span>
          </div>
          <code class="text-accent text-xs">client.{s.name}</code>
          {s.description && (
            <p class="mt-1.5 mb-0 text-sm text-white/60" set:html={renderMdInline(blurb(s.description))} />
          )}
        </a>
      ))
    }
  </section>
</DocsLayout>
