---
export type Props = {
  title: string;
  titleId?: string;
};

const { title, titleId } = Astro.props;
---

<div class="border border-white/20 bg-black shadow-[0_0_80px_rgba(0,0,0,0.6)]">
  <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-2.5">
    <div class="size-2 rounded-full bg-white/10"></div>
    <div class="size-2 rounded-full bg-white/10"></div>
    <div class="size-2 rounded-full bg-white/10"></div>
    <p id={titleId} class="m-0 ml-2 font-mono text-xs text-white/35">{title}</p>
  </div>
  <slot />
</div>
