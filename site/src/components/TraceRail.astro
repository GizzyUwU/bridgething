<div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-2 w-px md:left-3">
  <div class="bg-accent/12 absolute inset-0"></div>
  <div
    id="trace-fill"
    class="bg-accent absolute inset-x-0 top-0 h-[calc(var(--scroll,0)*100%)] origin-top [box-shadow:0_0_8px_var(--color-accent)]">
  </div>
</div>

<script>
  const fill = document.getElementById('trace-fill');
  let ticking = false;
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    fill?.style.setProperty('--scroll', String(p));
    ticking = false;
  };
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
</script>
