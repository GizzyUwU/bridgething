---
export type Props = {
  as?: 'h1' | 'h2' | 'span' | 'div';
  class?: string;
};

const { as: Tag = 'span', class: className } = Astro.props;
---

<Tag class:list={['font-display tracking-wordmark inline-block leading-none', className]}>
  <span class="font-medium">bridge</span><span class="font-extralight">thing</span>
</Tag>
