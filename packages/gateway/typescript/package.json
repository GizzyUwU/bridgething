{
  "name": "@bridgething/gateway",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "prebuild": "bun run gv",
    "build": "tsdown",
    "gv": "genversion --esm --semi src/version.ts"
  },
  "dependencies": {
    "@bridgething/lib": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.21.10",
    "genversion": "3.2.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
