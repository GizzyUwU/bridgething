{
  "name": "@bridgething/gateway",
  "version": "0.2.1",
  "description": "Typed gateway that drives a bridgething Spotify Car Thing over a pluggable transport.",
  "license": "MIT",
  "author": "Joey Eamigh <55670930+JoeyEamigh@users.noreply.github.com> (https://github.com/JoeyEamigh)",
  "homepage": "https://bridgething.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyEamigh/bridgething.git",
    "directory": "packages/gateway/typescript"
  },
  "bugs": {
    "url": "https://github.com/JoeyEamigh/bridgething/issues"
  },
  "keywords": ["bridgething", "spotify", "car-thing", "superbird", "gateway"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "bun run gv && rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gv": "genversion --esm --semi src/version.ts"
  },
  "dependencies": {
    "@bridgething/lib": "workspace:*"
  },
  "devDependencies": {
    "genversion": "3.2.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
