{
  "name": "@bridgething/gateway",
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "bun run gv && rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gv": "genversion --esm --semi src/version.ts"
  },
  "dependencies": {
    "@bridgething/lib": "workspace:*"
  },
  "devDependencies": {
    "genversion": "3.2.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
