{
  "name": "@bridgething/webapp-shared",
  "type": "module",
  "private": false,
  "version": "0.1.0",
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "default": "./dist/push.js"
    },
    "./tsconfig.json": "./tsconfig.json",
    "./gitignore": "./gitignore",
    "./styles.css": "./styles.css"
  },
  "files": ["dist", "fonts", "tsconfig.json", "gitignore", "styles.css"],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@msgpack/msgpack": "*",
    "@tailwindcss/vite": "*",
    "@vitejs/plugin-react": "*",
    "tailwindcss": "*",
    "typescript": "*",
    "vite": "*"
  }
}
