{
  "name": "@bridgething/updater",
  "version": "0.1.4",
  "description": "Transport-agnostic OTA updater for bridgething: library + bunx/npx CLI.",
  "license": "MIT",
  "author": "Joey Eamigh <55670930+JoeyEamigh@users.noreply.github.com> (https://github.com/JoeyEamigh)",
  "homepage": "https://bridgething.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyEamigh/bridgething.git",
    "directory": "packages/updater"
  },
  "bugs": {
    "url": "https://github.com/JoeyEamigh/bridgething/issues"
  },
  "keywords": ["bridgething", "spotify", "car-thing", "superbird", "ota", "updater"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "bridgething-updater": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "default": "./dist/websocket.js"
    },
    "./web-serial": {
      "types": "./dist/web-serial.d.ts",
      "default": "./dist/web-serial.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bridgething/adapter-network": "workspace:*",
    "@bridgething/gateway": "workspace:*",
    "@bridgething/lib": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
