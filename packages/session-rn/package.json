{
  "name": "@bridgething/session-react-native",
  "version": "0.1.0",
  "description": "bridgething companion session module for react native",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!**/.*"
  ],
  "scripts": {
    "nitro:codegen": "nitrogen",
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf lib nitrogen/generated"
  },
  "keywords": ["react-native", "ios", "android", "bridgething", "nitro"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyEamigh/bridgething.git"
  },
  "author": "Joey Eamigh <55670930+JoeyEamigh@users.noreply.github.com> (https://github.com/JoeyEamigh)",
  "license": "MIT",
  "devDependencies": {
    "@react-native-community/cli": "20.1.3",
    "@react-native/eslint-config": "0.85.2",
    "@types/react": "^19.2.14",
    "nitrogen": "^0.35.5",
    "react": "19.2.5",
    "react-native": "0.85.2",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "^0.35.5"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "packageManager": "bun@1.3.8",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["commonjs", { "esm": true }],
      ["module", { "esm": true }],
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  }
}
